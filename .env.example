# tokenzy example configuration.
# Copy and edit:  cp .env.example .env
#
# Notes:
#   - .env is gitignored; .env.example is committed.
#   - Real environment variables win over anything set in .env.
#   - Values are taken literally; keep comments on their own line.

# --- Admin account --------------------------------------------------------
# If the account does NOT exist, it is created at startup with these values.
# If it DOES exist, its password is left alone. To change it:
#   tokenzy admin-create -username admin -reset
TOKENZY_ADMIN_USERNAME=admin
TOKENZY_ADMIN_PASSWORD=change-this-password

# Read the password from a file instead of the environment (docker/k8s
# secrets). When set, this takes precedence over TOKENZY_ADMIN_PASSWORD.
# TOKENZY_ADMIN_PASSWORD_FILE=/run/secrets/tokenzy_admin_password

# --- Demo data ------------------------------------------------------------
# Inserts a demo project with prod and staging environments the first time the
# service starts against an empty database, so the panel has something to show.
# It contains no tokens and no API keys — seeding secrets would be a bad habit
# to build in. Restarts never duplicate it and real data is never overwritten.
#
# Set to 0 on a real deployment: a demo project on an empty database makes a
# lost volume look like a healthy fresh install, whereas an empty panel tells
# you straight away that the database did not survive.
TOKENZY_SEED_DATA=1

# --- Token limits ---------------------------------------------------------
# Longest lifetime a caller may request via ttlSeconds. There is also a hard
# ceiling of 10 years compiled in, which no configuration can raise.
TOKENZY_MAX_TTL=2160h

# --- Retention ------------------------------------------------------------
# How long finished tokens are kept before the cleanup job deletes them.
#
# This is not disk housekeeping. Tokens are stored in plaintext so the panel
# can show one again, which means every row kept past its usefulness is a
# secret sitting in a file for no reason.
#
# Expired tokens go quickly; spent and revoked ones are kept longer because
# they are the record of what was used and when.
TOKENZY_RETENTION_EXPIRED=168h
TOKENZY_RETENTION_CONSUMED=720h
TOKENZY_RETENTION_DELIVERIES=168h
TOKENZY_CLEANUP_INTERVAL=10m

# --- Docker Compose -------------------------------------------------------
# Host port, used only by docker-compose.local.yml. The deployment file
# publishes nothing: the platform's proxy reaches the container on 8080.
TOKENZY_PORT=8080
